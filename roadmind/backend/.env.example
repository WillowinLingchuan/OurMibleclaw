# RoadMind 配置示例。复制为 .env 后按需修改。
# use_mock=True 时无需真实模型凭据即可跑通全链路（判定/应急走内置规则模板）。

# mock 模式开关
USE_MOCK=true

# --- MoMA / LLM 网关（迭代阶段接入真实 LLM 时配置）---
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- 视频感知 (M1, YOLO + ByteTrack) ---
YOLO_MODEL=yolov8s.pt
YOLO_CONF=0.3
YOLO_IOU=0.6
YOLO_IMGSZ=640
YOLO_FRAME_STEP=1
YOLO_TRACK_THRESHOLD=0.25
YOLO_LOST_BUFFER=60
YOLO_TRACKER=bytetrack.yaml

# 上传与产物目录
UPLOAD_DIR=./data/uploads
OUTPUT_DIR=./data/outputs
